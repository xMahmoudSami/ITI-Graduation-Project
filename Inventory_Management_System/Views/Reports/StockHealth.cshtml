@model Inventory_Management_System.ViewModels.StockHealthReportViewModel

@{
    ViewData["Title"] = Loc["Nav_StockValuation"].Value;
}

<style>
    @@media print {
        @@page {
            size: A4 landscape !important;
            margin: 0 !important;
        }

        /* Safe printable padding optimized for A4 Landscape */
        .container-fluid,
        .container {
            padding: 8mm 12mm !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        /* Landscape KPI row spacing */
        .kpi-row {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            gap: 12px !important;
            margin-bottom: 0.75rem !important;
        }

        .kpi-row > div,
        .kpi-row > [class*="col-"] {
            flex: 1 1 0 !important;
            width: 25% !important;
            max-width: 25% !important;
            padding: 0 !important;
        }

        .kpi-card {
            padding: 0.25rem 0.5rem !important;
        }

        .kpi-card .card-body {
            padding: 0.35rem 0.5rem !important;
        }

        /* Landscape Table Layout: Expand naturally and avoid page splits */
        .table-responsive {
            overflow: visible !important;
            display: block !important;
        }

        .table {
            width: 100% !important;
            table-layout: auto !important;
            margin-bottom: 0 !important;
        }

        .table td,
        .table th {
            padding: 5px 8px !important;
            vertical-align: middle !important;
            white-space: nowrap !important;
        }

        /* Prevent table rows from mid-row page splits */
        tr {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        thead {
            display: table-header-group !important;
        }

        tfoot {
            display: table-footer-group !important;
        }
    }
</style>

<!-- Breadcrumbs (Hidden when printing) -->
<nav aria-label="breadcrumb" class="no-print">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item text-slate-400">@Loc["Nav_Reports"]</li>
        <li class="breadcrumb-item active text-slate-400" aria-current="page">@Loc["Nav_StockValuation"]</li>
    </ol>
</nav>

<!-- Page Header (Hidden when printing) -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h1 class="h3 mb-1 text-white font-weight-bold">
            <i class="fas fa-boxes-stacked text-primary mr-2"></i>@Loc["StockValuationAndHealth"]
        </h1>
        <p class="small mb-0 text-slate-400">
            @Loc["ProductStockValuationAndRestock"]
        </p>
    </div>
    <div class="btn-group mt-3 mt-sm-0">
        <a asp-action="ExportStockHealthCsv"
           asp-route-categoryId="@Model.CategoryID"
           asp-route-status="@Model.StatusFilter"
           asp-route-search="@Model.Search"
           class="btn btn-outline-success shadow-sm">
            <i class="fas fa-file-csv mr-1"></i> @Loc["ExportCSV"]
        </a>
        <button type="button" class="btn btn-primary shadow-sm" onclick="triggerPrint(null, event);">
            <i class="fas fa-print mr-1"></i> @Loc["PrintReport"]
        </button>
    </div>
</div>

<!-- Printable Header (Visible ONLY when printing) -->
<div class="print-only mb-4 border-bottom pb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="font-weight-bold mb-0">IMS Enterprise &bull; @Loc["StockValuationReport"]</h2>
            <p class="text-muted small mb-0">@Loc["Generated"] @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </div>
        <div class="text-right">
            <h4 class="font-weight-bold text-success mb-0">@Loc["TotalValuation"]: $@Model.TotalValuationAmount.ToString("N2")</h4>
            <span class="small text-muted">@Model.Items.Count @Loc["TotalItemsInReport"]</span>
        </div>
    </div>
</div>

<!-- KPI Metrics Row -->
<div class="row mb-4 kpi-row">
    <!-- Total Warehouse Valuation Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-success shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            @Loc["WarehouseValuation"]
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            $@Model.TotalValuationAmount.ToString("N2")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-coins fa-2x text-success" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Catalog Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-primary shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            @Loc["TotalProducts"]
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.TotalItemsCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-box-open fa-2x text-primary" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-warning shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            @Loc["LowStockItems"]
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.LowStockCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Out of Stock Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-danger shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            @Loc["OutOfStock"]
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.OutOfStockCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-ban fa-2x text-danger" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Card (Hidden when printing) -->
<div class="card shadow-sm mb-4 filter-card no-print">
    <div class="card-body py-3">
        <form method="get" asp-action="StockHealth" class="form-row align-items-end">
            <div class="col-md-4 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">@Loc["SearchByNameOrSku"]</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text border-right-0"><i class="fas fa-search text-slate-400"></i></span>
                    </div>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-left-0" placeholder="@Loc["SearchByNameOrSku"]" />
                </div>
            </div>
            <div class="col-md-3 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">@Loc["Category"]</label>
                <select name="categoryId" class="custom-select">
                    <option value="">— @Loc["AllCategories"] —</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">@Loc["StockStatus"]</label>
                <select name="status" class="custom-select">
                    <option value="All" selected="@(Model.StatusFilter == "All")">@Loc["AllStatuses"]</option>
                    <option value="InStock" selected="@(Model.StatusFilter == "InStock")">@Loc["InStock"] (@Loc["HealthyStockItems"])</option>
                    <option value="LowStock" selected="@(Model.StatusFilter == "LowStock")">@Loc["LowStock"] (@Loc["FastRestockRequired"])</option>
                    <option value="OutOfStock" selected="@(Model.StatusFilter == "OutOfStock")">@Loc["OutOfStock"]</option>
                </select>
            </div>
            <div class="col-md-2 d-flex">
                <button type="submit" class="btn btn-primary btn-block mr-1">
                    <i class="fas fa-filter mr-1"></i> @Loc["Apply"]
                </button>
                @if (Model.CategoryID.HasValue || (Model.StatusFilter != null && Model.StatusFilter != "All") || !string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-action="StockHealth" class="btn btn-outline-secondary" title="@Loc["Reset"]">
                        <i class="fas fa-undo"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Stock Valuation Breakdown Table Card -->
<div class="card shadow-sm mb-4 table-card">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-table text-primary mr-2"></i>@Loc["ProductStockValuationAndRestock"] (@Model.Items.Count @Loc["ItemsDisplayed"])
        </h6>
        <span class="badge border badge-light px-2 py-1">
            @Loc["FilteredSubtotal"] $@Model.Items.Sum(i => i.TotalValue).ToString("N2")
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-box-open fa-3x" style="color: #475569;"></i>
                </div>
                <h5 class="text-white font-weight-bold">@Loc["NoProductsMatchCriteria"]</h5>
                <p class="text-slate-400 mb-3">@Loc["AdjustCriteriaHint"]</p>
                <a asp-action="StockHealth" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="fas fa-undo mr-1"></i> @Loc["ResetAllFilters"]
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="stockValuationTable">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 25%;">@Loc["ProductAndSku"]</th>
                            <th style="width: 15%;">@Loc["Category"]</th>
                            <th class="text-right" style="width: 12%;">@Loc["UnitPrice"]</th>
                            <th class="text-center" style="width: 16%;">@Loc["CurrentStockThreshold"]</th>
                            <th class="text-center" style="width: 12%;">@Loc["Status"]</th>
                            <th class="text-right" style="width: 12%;">@Loc["Valuation"]</th>
                            <th class="text-center no-print" style="width: 8%;">@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            bool isOut = item.StockQuantity == 0;
                            bool isLow = !isOut && item.StockQuantity <= item.Threshold;
                            int percent = item.Threshold > 0
                                ? Math.Min(100, (int)((double)item.StockQuantity / item.Threshold * 100))
                                : (item.StockQuantity > 0 ? 100 : 0);

                            <tr class="stock-row @(isOut ? "table-danger-light" : isLow ? "table-warning-light" : "")">
                                <td class="product-name-col">
                                    <div class="font-weight-bold text-white product-name">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID" class="text-white text-decoration-none">
                                            @item.ProductName
                                        </a>
                                    </div>
                                    <div class="small text-slate-400 sku-col">
                                        @Loc["SKU"]: <code class="sku">@item.SKU</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-category border px-2 py-1">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td class="text-right font-weight-bold text-white unit-price">
                                    $@item.UnitPrice.ToString("N2")
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between small font-weight-bold mb-1">
                                        <span class="@(isOut ? "text-danger" : isLow ? "text-warning" : "text-success")">
                                             @item.StockQuantity @Loc["Units"]
                                        </span>
                                        <span class="text-slate-400">@Loc["Min"] @item.Threshold</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(isOut ? "bg-danger" : isLow ? "bg-warning" : "bg-success")"
                                             role="progressbar"
                                             style="width: @percent%;"
                                             aria-valuenow="@item.StockQuantity"
                                             aria-valuemin="0"
                                             aria-valuemax="@item.Threshold">
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (isOut)
                                    {
                                        <span class="badge badge-danger px-2 py-1 font-weight-bold">
                                            <i class="fas fa-times-circle mr-1"></i> @Loc["OutOfStock"]
                                        </span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge badge-warning px-2 py-1 font-weight-bold">
                                            <i class="fas fa-exclamation-triangle mr-1"></i> @Loc["LowStock"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success px-2 py-1 font-weight-bold">
                                            <i class="fas fa-check-circle mr-1"></i> @Loc["InStock"]
                                        </span>
                                    }
                                </td>
                                <td class="text-right font-weight-bold text-success h6 mb-0 subtotal">
                                    $@item.TotalValue.ToString("N2")
                                </td>
                                <td class="text-center no-print">
                                    @if (item.IsRestockNeeded)
                                    {
                                        <a asp-controller="Purchases" asp-action="Create" class="btn btn-sm btn-outline-warning" title="@Loc["Restock"]">
                                            <i class="fas fa-cart-plus mr-1"></i> @Loc["Restock"]
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-outline-secondary" title="@Loc["Details"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="thead-light font-weight-bold">
                        <tr>
                            <td colspan="5" class="text-right text-uppercase small text-slate-300">@Loc["TotalValuationOfDisplayed"]</td>
                            <td class="text-right text-success h5 mb-0 subtotal">$@Model.Items.Sum(i => i.TotalValue).ToString("N2")</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

