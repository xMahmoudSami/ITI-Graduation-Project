@model Inventory_Management_System.ViewModels.StockHealthReportViewModel

@{
    ViewData["Title"] = "Stock Valuation";
}

<!-- Breadcrumbs (Hidden when printing) -->
<nav aria-label="breadcrumb" class="no-print">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item text-slate-400">Reports</li>
        <li class="breadcrumb-item active text-slate-400" aria-current="page">Stock Valuation</li>
    </ol>
</nav>

<!-- Page Header (Hidden when printing) -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h1 class="h3 mb-1 text-white font-weight-bold">
            <i class="fas fa-boxes-stacked text-primary mr-2"></i>Stock Valuation & Inventory Health
        </h1>
        <p class="small mb-0 text-slate-400">
            Real-time warehouse valuation, item stock levels vs thresholds, status badges, and fast restock indicators
        </p>
    </div>
    <div class="btn-group mt-3 mt-sm-0">
        <a asp-action="ExportStockHealthCsv"
           asp-route-categoryId="@Model.CategoryID"
           asp-route-status="@Model.StatusFilter"
           asp-route-search="@Model.Search"
           class="btn btn-outline-success shadow-sm">
            <i class="fas fa-file-csv mr-1"></i> Export CSV
        </a>
        <button type="button" class="btn btn-primary shadow-sm" onclick="window.print();">
            <i class="fas fa-print mr-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Printable Header (Visible ONLY when printing) -->
<div class="print-only mb-4 border-bottom pb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="font-weight-bold mb-0">IMS Enterprise &bull; Stock Valuation Report</h2>
            <p class="text-muted small mb-0">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </div>
        <div class="text-right">
            <h4 class="font-weight-bold text-success mb-0">Total Valuation: $@Model.TotalValuationAmount.ToString("N2")</h4>
            <span class="small text-muted">@Model.Items.Count items in this report</span>
        </div>
    </div>
</div>

<!-- KPI Metrics Row -->
<div class="row mb-4 kpi-row">
    <!-- Total Warehouse Valuation Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-success shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Total Stock Valuation
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            $@Model.TotalValuationAmount.ToString("N2")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-coins fa-2x text-success" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Catalog Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-primary shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Total Catalog Products
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.TotalItemsCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-box-open fa-2x text-primary" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-warning shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Low Stock Items
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.LowStockCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Out of Stock Items Card -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-left-danger shadow-sm h-100 py-2 kpi-card">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            Out of Stock Items
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-white">
                            @Model.OutOfStockCount.ToString("N0")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-ban fa-2x text-danger" style="opacity: 0.45;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Card (Hidden when printing) -->
<div class="card shadow-sm mb-4 filter-card no-print">
    <div class="card-body py-3">
        <form method="get" asp-action="StockHealth" class="form-row align-items-end">
            <div class="col-md-4 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">Search Product / SKU</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text border-right-0" style="background: #1a2234; border-color: #334155;"><i class="fas fa-search text-slate-400"></i></span>
                    </div>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-left-0" style="background: #0f172a; border-color: #334155; color: #ffffff;" placeholder="Filter by product name or SKU..." />
                </div>
            </div>
            <div class="col-md-3 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">Category</label>
                <select name="categoryId" class="custom-select" style="background-color: #0f172a !important; border-color: #334155 !important; color: #ffffff !important;">
                    <option value="">— All Categories —</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-2 mb-md-0">
                <label class="small font-weight-bold text-slate-400 mb-1">Stock Status</label>
                <select name="status" class="custom-select" style="background-color: #0f172a !important; border-color: #334155 !important; color: #ffffff !important;">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All Statuses</option>
                    <option value="InStock" selected="@(Model.StatusFilter == "InStock")">In Stock (Healthy)</option>
                    <option value="LowStock" selected="@(Model.StatusFilter == "LowStock")">Low Stock (At or Below Threshold)</option>
                    <option value="OutOfStock" selected="@(Model.StatusFilter == "OutOfStock")">Out of Stock (Zero Units)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex">
                <button type="submit" class="btn btn-primary btn-block mr-1">
                    <i class="fas fa-filter mr-1"></i> Apply
                </button>
                @if (Model.CategoryID.HasValue || (Model.StatusFilter != null && Model.StatusFilter != "All") || !string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-action="StockHealth" class="btn btn-outline-secondary" style="border-color: #475569; color: #cbd5e1;" title="Reset Filters">
                        <i class="fas fa-undo"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Stock Valuation Breakdown Table Card -->
<div class="card shadow-sm mb-4 table-card">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-table text-primary mr-2"></i>Product Stock Valuation & Restock Status (@Model.Items.Count Items Displayed)
        </h6>
        <span class="badge border text-slate-300 px-2 py-1" style="background: #1e293b; border-color: #334155;">
            Filtered Subtotal: $@Model.Items.Sum(i => i.TotalValue).ToString("N2")
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-box-open fa-3x" style="color: #475569;"></i>
                </div>
                <h5 class="text-white font-weight-bold">No products match your criteria</h5>
                <p class="text-slate-400 mb-3">Try adjusting your category, status, or search filters.</p>
                <a asp-action="StockHealth" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="fas fa-undo mr-1"></i> Reset All Filters
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="stockValuationTable">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 25%;">PRODUCT & SKU</th>
                            <th style="width: 15%;">CATEGORY</th>
                            <th class="text-right" style="width: 12%;">UNIT PRICE</th>
                            <th class="text-center" style="width: 16%;">CURRENT STOCK / THRESHOLD</th>
                            <th class="text-center" style="width: 12%;">STATUS</th>
                            <th class="text-right" style="width: 12%;">VALUATION ($)</th>
                            <th class="text-center no-print" style="width: 8%;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            bool isOut = item.StockQuantity == 0;
                            bool isLow = !isOut && item.StockQuantity <= item.Threshold;
                            int percent = item.Threshold > 0
                                ? Math.Min(100, (int)((double)item.StockQuantity / item.Threshold * 100))
                                : (item.StockQuantity > 0 ? 100 : 0);

                            <tr class="stock-row @(isOut ? "table-danger-light" : isLow ? "table-warning-light" : "")">
                                <td>
                                    <div class="font-weight-bold text-white">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID" class="text-white text-decoration-none">
                                            @item.ProductName
                                        </a>
                                    </div>
                                    <div class="small text-slate-400">
                                        SKU: <code style="background: #1e293b; color: #a5b4fc; border: 1px solid #334155;">@item.SKU</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge border px-2 py-1" style="background: #1e293b; color: #e2e8f0; border-color: #334155;">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td class="text-right font-weight-bold text-white">
                                    $@item.UnitPrice.ToString("N2")
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between small font-weight-bold mb-1">
                                        <span class="@(isOut ? "text-danger" : isLow ? "text-warning" : "text-success")">
                                            @item.StockQuantity units
                                        </span>
                                        <span class="text-slate-400">Min: @item.Threshold</span>
                                    </div>
                                    <div class="progress" style="height: 6px; background: #1e293b;">
                                        <div class="progress-bar @(isOut ? "bg-danger" : isLow ? "bg-warning" : "bg-success")"
                                             role="progressbar"
                                             style="width: @percent%;"
                                             aria-valuenow="@item.StockQuantity"
                                             aria-valuemin="0"
                                             aria-valuemax="@item.Threshold">
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (isOut)
                                    {
                                        <span class="badge badge-danger px-2 py-1 font-weight-bold">
                                            <i class="fas fa-times-circle mr-1"></i> Out of Stock
                                        </span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge badge-warning px-2 py-1 font-weight-bold">
                                            <i class="fas fa-exclamation-triangle mr-1"></i> Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success px-2 py-1 font-weight-bold">
                                            <i class="fas fa-check-circle mr-1"></i> In Stock
                                        </span>
                                    }
                                </td>
                                <td class="text-right font-weight-bold text-success h6 mb-0">
                                    $@item.TotalValue.ToString("N2")
                                </td>
                                <td class="text-center no-print">
                                    @if (item.IsRestockNeeded)
                                    {
                                        <a asp-controller="Purchases" asp-action="Create" class="btn btn-sm btn-outline-warning" title="Order Stock for this product">
                                            <i class="fas fa-cart-plus mr-1"></i> Restock
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-outline-secondary" title="View details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="thead-light font-weight-bold">
                        <tr>
                            <td colspan="5" class="text-right text-uppercase small text-slate-300">Total Valuation of Displayed Items:</td>
                            <td class="text-right text-success h5 mb-0">$@Model.Items.Sum(i => i.TotalValue).ToString("N2")</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

