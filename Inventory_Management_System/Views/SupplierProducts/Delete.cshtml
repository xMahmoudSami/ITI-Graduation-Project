@model Inventory_Management_System.ViewModels.SupplierProductDeleteViewModel

@{
    ViewData["Title"] = "Remove Supplier-Product Mapping";
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Supplier Mappings</a></li>
        <li class="breadcrumb-item active" aria-current="page">Remove Mapping</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm mb-4 border-left-danger">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-danger">
                    <i class="fas fa-unlink mr-2"></i>Remove Supplier-Product Mapping
                </h6>
            </div>
            <div class="card-body">
                <div class="alert alert-danger mb-3" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    <strong>Warning:</strong> Are you sure you want to remove this mapping? The relationship between this supplier and product will be unlinked.
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-gray-600">Supplier</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-truck text-primary mr-1"></i>@Model.SupplierName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Product</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-box text-primary mr-1"></i>@Model.ProductName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Supplier SKU</dt>
                    <dd class="col-sm-8"><code>@Model.SupplierSKU</code></dd>

                    <dt class="col-sm-4 text-gray-600">Contract Price</dt>
                    <dd class="col-sm-8 font-weight-bold">$@Model.ContractPrice.ToString("N2")</dd>

                    <dt class="col-sm-4 text-gray-600">Lead Time</dt>
                    <dd class="col-sm-8">@Model.LeadTimeDays days</dd>
                </dl>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Cancel
                    </a>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SupplierProductID" />
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-unlink mr-1"></i> Remove Mapping
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
