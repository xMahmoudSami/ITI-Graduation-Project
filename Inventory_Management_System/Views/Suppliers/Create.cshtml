@model Inventory_Management_System.ViewModels.SupplierFormViewModel

@{
    ViewData["Title"] = Loc["AddNewSupplier"].Value;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Loc["Nav_Suppliers"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Loc["AddNewSupplier"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-truck mr-2"></i>@Loc["AddNewSupplier"]
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SupplierName" class="font-weight-bold">
                                    @Loc["Supplier"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierName" class="form-control" placeholder="@Loc["Supplier"]" autofocus />
                                <span asp-validation-for="SupplierName" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ContactName" class="font-weight-bold">
                                    @Loc["ContactPerson"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ContactName" class="form-control" placeholder="@Loc["ContactPerson"]" />
                                <span asp-validation-for="ContactName" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Phone" class="font-weight-bold">
                                    @Loc["Phone"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Phone" class="form-control" placeholder="@Loc["Phone"]" type="tel" />
                                <span asp-validation-for="Phone" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Email" class="font-weight-bold">
                                    @Loc["Email"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="@Loc["Email"]" type="email" />
                                <span asp-validation-for="Email" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="font-weight-bold">
                            @Loc["Address"] <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="@Loc["Address"]"></textarea>
                        <span asp-validation-for="Address" class="text-danger small font-weight-bold"></span>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["BackToSuppliers"]
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save mr-1"></i> @Loc["Save"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
