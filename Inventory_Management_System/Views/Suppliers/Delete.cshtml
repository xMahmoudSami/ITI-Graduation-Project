@model Inventory_Management_System.ViewModels.SupplierDeleteViewModel

@{
    ViewData["Title"] = Loc["DeleteSupplier"].Value;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Loc["Nav_Suppliers"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Loc["Delete"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm mb-4 border-left-@(Model.CanDelete ? "danger" : "warning")">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-@(Model.CanDelete ? "danger" : "warning")">
                    <i class="fas fa-@(Model.CanDelete ? "trash-alt" : "exclamation-triangle") mr-2"></i>
                    @(Model.CanDelete ? Loc["DeleteSupplier"] : Loc["CannotDeleteTitle"])
                </h6>
            </div>
            <div class="card-body">
                @if (!Model.CanDelete)
                {
                    <div class="alert alert-danger border-left-danger d-flex align-items-center mb-4" role="alert">
                        <i class="fas fa-ban mr-3 text-danger fa-lg"></i>
                        <div>
                            <strong>@Loc["DeletionBlocked"]</strong> @Model.BlockingReason
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-left-warning d-flex align-items-center mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle mr-3 text-warning fa-lg"></i>
                        <div>
                            <strong>@Loc["DeleteWarningMessage"]</strong>
                            @if (Model.MappedProductsCount > 0)
                            {
                                <text> @Model.MappedProductsCount mapping(s).</text>
                            }
                        </div>
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-slate-400">@Loc["Supplier"]</dt>
                    <dd class="col-sm-8 font-weight-bold text-white">
                        <i class="fas fa-building text-primary mr-1"></i>@Model.SupplierName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">@Loc["ContactPerson"]</dt>
                    <dd class="col-sm-8 text-gray-700">@Model.ContactName</dd>

                    <dt class="col-sm-4 text-gray-600">@Loc["Phone"]</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-gray-600">@Loc["Email"]</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-gray-600">@Loc["Nav_SupplierMappings"]</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.MappedProductsCount > 0 ? "badge-info" : "badge-secondary") px-2 py-1">
                            @Model.MappedProductsCount
                        </span>
                    </dd>

                    @if (Model.PurchasesCount > 0)
                    {
                        <dt class="col-sm-4 text-gray-600">@Loc["Nav_Purchases"]</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-success px-2 py-1">@Model.PurchasesCount</span>
                        </dd>
                    }
                </dl>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["CancelAndKeep"]
                        </a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.SupplierID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash mr-1"></i> @Loc["ConfirmDelete"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["BackToSuppliers"]
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.SupplierID" class="btn btn-info">
                            <i class="fas fa-eye mr-1"></i> @Loc["Details"]
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
