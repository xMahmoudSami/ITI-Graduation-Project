@model Inventory_Management_System.ViewModels.SupplierDetailsViewModel

@{
    ViewData["Title"] = Model.SupplierName;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Suppliers</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SupplierName</li>
    </ol>
</nav>

<!-- Supplier Info & Stats -->
<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-truck mr-2"></i>Supplier Information
                </h6>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Edit" asp-route-id="@Model.SupplierID" class="btn btn-outline-primary" title="Edit">
                        <i class="fas fa-edit mr-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.SupplierID" class="btn btn-outline-danger" title="Delete">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-gray-600">Supplier Name</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-building text-primary mr-1"></i>@Model.SupplierName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Contact Person</dt>
                    <dd class="col-sm-8 text-gray-700">@Model.ContactName</dd>

                    <dt class="col-sm-4 text-gray-600">Phone</dt>
                    <dd class="col-sm-8">
                        <a href="tel:@Model.Phone" class="text-decoration-none">
                            <i class="fas fa-phone-alt mr-1 text-muted"></i>@Model.Phone
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Email</dt>
                    <dd class="col-sm-8">
                        <a href="mailto:@Model.Email" class="text-decoration-none">
                            <i class="fas fa-envelope mr-1 text-muted"></i>@Model.Email
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Address</dt>
                    <dd class="col-sm-8 text-gray-700">@Model.Address</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="col-lg-4">
        <div class="card border-left-info shadow-sm mb-3">
            <div class="card-body py-3">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Supplied Products</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.MappedProducts.Count</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-boxes fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>

        <div class="card border-left-success shadow-sm mb-3">
            <div class="card-body py-3">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Purchase Orders</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PurchasesCount</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-shopping-cart fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>

        <a asp-controller="SupplierProducts" asp-action="Create" asp-route-supplierId="@Model.SupplierID" class="btn btn-sm btn-info btn-block mb-3">
            <i class="fas fa-link mr-1"></i> Map New Product
        </a>
    </div>
</div>

<!-- Mapped Products Table -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-boxes mr-2"></i>Products Supplied by @Model.SupplierName (@Model.MappedProducts.Count)
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.MappedProducts.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-boxes fa-2x text-gray-300 mb-2"></i>
                <p class="text-muted mb-2">No products are currently associated with this supplier.</p>
                <a asp-controller="SupplierProducts" asp-action="Create" asp-route-supplierId="@Model.SupplierID" class="btn btn-info btn-sm">
                    <i class="fas fa-plus mr-1"></i> Map Product
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Supplier SKU</th>
                            <th class="text-right">Contract Price</th>
                            <th class="text-center">Lead Time</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in Model.MappedProducts)
                        {
                            <tr>
                                <td class="font-weight-bold">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.ProductID">@prod.ProductName</a>
                                    <small class="text-muted d-block">SKU: @prod.SKU</small>
                                </td>
                                <td>@prod.CategoryName</td>
                                <td><code>@prod.SupplierSKU</code></td>
                                <td class="text-right font-weight-bold">$@prod.ContractPrice.ToString("N2")</td>
                                <td class="text-center">@prod.LeadTimeDays days</td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="SupplierProducts" asp-action="Edit" asp-route-id="@prod.SupplierProductID" class="btn btn-outline-primary" title="Edit Mapping">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="SupplierProducts" asp-action="Delete" asp-route-id="@prod.SupplierProductID" class="btn btn-outline-danger" title="Remove Mapping">
                                            <i class="fas fa-unlink"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">
    <i class="fas fa-arrow-left mr-1"></i> Back to Suppliers
</a>
