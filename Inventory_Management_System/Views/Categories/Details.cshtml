@model Inventory_Management_System.ViewModels.CategoryDetailsViewModel

@{
    ViewData["Title"] = "Category Details - " + Model.CategoryName;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.CategoryName</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-folder text-primary mr-2"></i>@Model.CategoryName
        </h1>
        <p class="text-muted small mb-0">Detailed view and products belonging to this category</p>
    </div>
    <div class="btn-group" role="group">
        <a asp-action="Edit" asp-route-id="@Model.CategoryID" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-edit mr-1"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.CategoryID" class="btn btn-outline-danger btn-sm">
            <i class="fas fa-trash mr-1"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left mr-1"></i> Back to Categories
        </a>
    </div>
</div>

<div class="row">
    <!-- Category Overview Card -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Category Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Category ID:</dt>
                    <dd class="col-sm-7 font-weight-bold">#@Model.CategoryID</dd>

                    <dt class="col-sm-5 text-muted">Category Name:</dt>
                    <dd class="col-sm-7 font-weight-bold text-gray-800">@Model.CategoryName</dd>

                    <dt class="col-sm-5 text-muted">Total Products:</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.ProductsCount > 0 ? "badge-info" : "badge-secondary") px-2 py-1">
                            @Model.ProductsCount @(Model.ProductsCount == 1 ? "Product" : "Products")
                        </span>
                    </dd>

                    <dt class="col-sm-12 text-muted mt-2">Description:</dt>
                    <dd class="col-sm-12 text-gray-700 bg-light p-3 rounded mt-1">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this category." : Model.Description)
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
                <a asp-controller="Products" asp-action="Create" asp-route-categoryId="@Model.CategoryID" class="btn btn-primary btn-block btn-sm">
                    <i class="fas fa-plus mr-1"></i> Add Product to this Category
                </a>
            </div>
        </div>
    </div>

    <!-- Products in this Category -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">
                    Products in this Category (@Model.ProductsCount)
                </h6>
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryID" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-external-link-alt mr-1"></i> View in Products List
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Products.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-box-open fa-3x text-gray-300 mb-3"></i>
                        <h6 class="text-gray-600 font-weight-bold">No products assigned yet</h6>
                        <p class="text-muted small mb-3">There are no products currently associated with this category.</p>
                        <a asp-controller="Products" asp-action="Create" asp-route-categoryId="@Model.CategoryID" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus mr-1"></i> Add First Product
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>SKU</th>
                                    <th>Product Name</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-center">Stock</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.Products)
                                {
                                    <tr>
                                        <td>
                                            <code>@prod.SKU</code>
                                        </td>
                                        <td class="font-weight-bold">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.ProductID">
                                                @prod.ProductName
                                            </a>
                                        </td>
                                        <td class="text-right">$@prod.UnitPrice.ToString("N2")</td>
                                        <td class="text-center font-weight-bold">@prod.StockQuantity</td>
                                        <td class="text-center">
                                            <span class="badge @prod.StockBadgeClass px-2 py-1">@prod.StockStatus</span>
                                        </td>
                                        <td class="text-right">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.ProductID" class="btn btn-outline-info btn-sm" title="View Product">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
