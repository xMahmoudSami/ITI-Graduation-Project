@model Inventory_Management_System.ViewModels.CategoryDeleteViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm mb-4 border-left-@(Model.CanDelete ? "danger" : "warning")">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-@(Model.CanDelete ? "danger" : "warning")">
                    <i class="fas fa-@(Model.CanDelete ? "trash-alt" : "exclamation-triangle") mr-2"></i>
                    @(Model.CanDelete ? "Delete Category" : "Cannot Delete Category")
                </h6>
            </div>
            <div class="card-body">
                @if (!Model.CanDelete)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <strong>Deletion Blocked:</strong> @Model.BlockingMessage
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mb-3" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. Please confirm you want to permanently delete this category.
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-gray-600">Category Name</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-folder text-primary mr-1"></i>@Model.CategoryName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Description</dt>
                    <dd class="col-sm-8 text-gray-700">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Products Count</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.ProductsCount > 0 ? "badge-info" : "badge-secondary") px-2 py-1">
                            @Model.ProductsCount @(Model.ProductsCount == 1 ? "product" : "products")
                        </span>
                    </dd>
                </dl>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Cancel
                        </a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.CategoryID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash mr-1"></i> Delete Category
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Categories
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.CategoryID" class="btn btn-info">
                            <i class="fas fa-eye mr-1"></i> View Products
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
