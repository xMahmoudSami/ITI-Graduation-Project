@model Inventory_Management_System.ViewModels.CategoryFormViewModel

@{
    ViewData["Title"] = Loc["AddNewCategory"].Value;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Loc["Nav_Categories"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Loc["AddNewCategory"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-folder-plus mr-2"></i>@Loc["AddNewCategory"]
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="CategoryName" class="font-weight-bold">
                            @Loc["Category"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CategoryName" class="form-control" placeholder="@Loc["Category"]" autofocus />
                        <span asp-validation-for="CategoryName" class="text-danger small font-weight-bold"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="font-weight-bold">@Loc["Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="@Loc["Description"]"></textarea>
                        <span asp-validation-for="Description" class="text-danger small font-weight-bold"></span>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["BackToCategories"]
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save mr-1"></i> @Loc["Save"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
