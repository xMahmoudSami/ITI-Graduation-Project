@model Inventory_Management_System.ViewModels.PagedResult<Inventory_Management_System.ViewModels.CategoryListItemViewModel>

@{
    ViewData["Title"] = "Categories";
    var filter = ViewBag.Filter as Inventory_Management_System.ViewModels.CategoryFilterViewModel ?? new();
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Categories</h1>
        <p class="text-muted small mb-0">Organize and manage inventory product categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm">
        <span class="icon text-white-50">
            <i class="fas fa-plus"></i>
        </span>
        <span class="text">Add Category</span>
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="form-inline">
            <div class="input-group mr-sm-2 mb-2 mb-sm-0 flex-grow-1" style="max-width: 400px;">
                <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Search by category name..." aria-label="Search">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary" title="Search">
                        <i class="fas fa-search fa-sm"></i> Search
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(filter.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm ml-2">
                    <i class="fas fa-times mr-1"></i> Clear
                </a>
            }
        </form>
    </div>
</div>

<!-- Category List Table Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">All Categories (@Model.TotalItems)</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-tags fa-3x text-gray-300 mb-3"></i>
                <h5 class="text-gray-600 font-weight-bold">No categories found</h5>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(filter.Search))
                    {
                        <text>No categories match your search criteria. Try clearing the search filter.</text>
                    }
                    else
                    {
                        <text>Start by creating your first product category.</text>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(filter.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear Filter</a>
                }
                else
                {
                    <a asp-action="Create" class="btn btn-primary btn-sm">Create Category</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 25%;">Category Name</th>
                            <th>Description</th>
                            <th class="text-center" style="width: 15%;">Products Count</th>
                            <th class="text-right" style="width: 22%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-weight-bold text-gray-800">
                                    <i class="fas fa-folder text-primary mr-2"></i>
                                    <a asp-action="Details" asp-route-id="@item.CategoryID">@item.CategoryName</a>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.ProductsCount > 0 ? "badge-info" : "badge-secondary") px-2 py-1">
                                        @item.ProductsCount @(item.ProductsCount == 1 ? "product" : "products")
                                    </span>
                                </td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.CategoryID" class="btn btn-outline-info" title="View Details">
                                            <i class="fas fa-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CategoryID" class="btn btn-outline-primary" title="Edit Category">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryID" class="btn btn-outline-danger" title="Delete Category">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-3 pb-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
    </div>
</div>
