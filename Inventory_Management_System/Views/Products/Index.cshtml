@model Inventory_Management_System.ViewModels.PagedResult<Inventory_Management_System.ViewModels.ProductListItemViewModel>

@{
    ViewData["Title"] = "Products";
    var filter = ViewBag.Filter as Inventory_Management_System.ViewModels.ProductFilterViewModel ?? new();
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Products</h1>
        <p class="text-muted small mb-0">Manage inventory products, stock levels, and pricing</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm">
        <span class="icon text-white-50">
            <i class="fas fa-plus"></i>
        </span>
        <span class="text">Add Product</span>
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index">
            <div class="row align-items-end">
                <div class="col-md-4 mb-2 mb-md-0">
                    <label class="small text-muted mb-1">Search by Name or SKU</label>
                    <div class="input-group">
                        <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Search products..." aria-label="Search">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary" title="Search">
                                <i class="fas fa-search fa-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <label class="small text-muted mb-1">Category</label>
                    <select name="CategoryID" class="custom-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in filter.Categories)
                        {
                            <option value="@cat.Value" selected="@(cat.Value == filter.CategoryID?.ToString())">@cat.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <label class="small text-muted mb-1">Stock Status</label>
                    <select name="Status" class="custom-select">
                        <option value="0" selected="@(filter.Status == Inventory_Management_System.ViewModels.StockStatusFilter.All)">All Statuses</option>
                        <option value="1" selected="@(filter.Status == Inventory_Management_System.ViewModels.StockStatusFilter.InStock)">In Stock</option>
                        <option value="2" selected="@(filter.Status == Inventory_Management_System.ViewModels.StockStatusFilter.LowStock)">Low Stock</option>
                        <option value="3" selected="@(filter.Status == Inventory_Management_System.ViewModels.StockStatusFilter.OutOfStock)">Out of Stock</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2 mb-md-0 d-flex">
                    <button type="submit" class="btn btn-primary mr-1 flex-grow-1">
                        <i class="fas fa-filter fa-sm"></i> Filter
                    </button>
                    @if (!string.IsNullOrWhiteSpace(filter.Search) || filter.CategoryID.HasValue || filter.Status != Inventory_Management_System.ViewModels.StockStatusFilter.All)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Product List Table Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">All Products (@Model.TotalItems)</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-gray-300 mb-3"></i>
                <h5 class="text-gray-600 font-weight-bold">No products found</h5>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(filter.Search) || filter.CategoryID.HasValue || filter.Status != Inventory_Management_System.ViewModels.StockStatusFilter.All)
                    {
                        <text>No products match your search criteria. Try clearing the filters.</text>
                    }
                    else
                    {
                        <text>Start by adding your first product to the inventory.</text>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(filter.Search) || filter.CategoryID.HasValue || filter.Status != Inventory_Management_System.ViewModels.StockStatusFilter.All)
                {
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear Filters</a>
                }
                else
                {
                    <a asp-action="Create" class="btn btn-primary btn-sm">Add Product</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 10%;">SKU</th>
                            <th style="width: 20%;">Product Name</th>
                            <th>Category</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Status</th>
                            <th class="text-right" style="width: 22%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code>@item.SKU</code></td>
                                <td class="font-weight-bold text-gray-800">
                                    <i class="fas fa-box text-primary mr-1"></i>
                                    <a asp-action="Details" asp-route-id="@item.ProductID">@item.ProductName</a>
                                </td>
                                <td>
                                    <a asp-controller="Categories" asp-action="Details" asp-route-id="@item.CategoryID" class="text-decoration-none">
                                        @item.CategoryName
                                    </a>
                                </td>
                                <td class="text-right font-weight-bold">$@item.UnitPrice.ToString("N2")</td>
                                <td class="text-center">
                                    @item.StockQuantity
                                    <small class="text-muted d-block">thresh: @item.LowStockThreshold</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge @item.StockBadgeClass px-2 py-1">@item.StockStatus</span>
                                </td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-outline-info">
                                            <i class="fas fa-eye mr-1"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-outline-primary">
                                            <i class="fas fa-edit mr-1"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-outline-danger">
                                            <i class="fas fa-trash mr-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-3 pb-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
    </div>
</div>
