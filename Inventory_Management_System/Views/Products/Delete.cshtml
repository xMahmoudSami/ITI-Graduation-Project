@model Inventory_Management_System.ViewModels.ProductDeleteViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm mb-4 border-left-@(Model.CanDelete ? "danger" : "warning")">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-@(Model.CanDelete ? "danger" : "warning")">
                    <i class="fas fa-@(Model.CanDelete ? "trash-alt" : "exclamation-triangle") mr-2"></i>
                    @(Model.CanDelete ? "Delete Product" : "Cannot Delete Product")
                </h6>
            </div>
            <div class="card-body">
                @if (!Model.CanDelete)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <strong>Deletion Blocked:</strong> @Model.BlockingReason
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mb-3" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Warning:</strong> This action cannot be undone.
                        @if (Model.SupplierProductsCount > 0)
                        {
                            <text> Deleting this product will also remove @Model.SupplierProductsCount supplier mapping(s).</text>
                        }
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-gray-600">SKU</dt>
                    <dd class="col-sm-8"><code class="font-weight-bold">@Model.SKU</code></dd>

                    <dt class="col-sm-4 text-gray-600">Product Name</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-box text-primary mr-1"></i>@Model.ProductName
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4 text-gray-600">Unit Price</dt>
                    <dd class="col-sm-8">$@Model.UnitPrice.ToString("N2")</dd>

                    <dt class="col-sm-4 text-gray-600">Stock Quantity</dt>
                    <dd class="col-sm-8">@Model.StockQuantity</dd>

                    @if (Model.SupplierProductsCount > 0)
                    {
                        <dt class="col-sm-4 text-gray-600">Supplier Mappings</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-info px-2 py-1">@Model.SupplierProductsCount mapping(s)</span>
                        </dd>
                    }

                    @if (Model.PurchaseItemsCount > 0)
                    {
                        <dt class="col-sm-4 text-gray-600">Purchase Records</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-success px-2 py-1">@Model.PurchaseItemsCount record(s)</span>
                        </dd>
                    }

                    @if (Model.SaleItemsCount > 0)
                    {
                        <dt class="col-sm-4 text-gray-600">Sales Records</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-warning px-2 py-1">@Model.SaleItemsCount record(s)</span>
                        </dd>
                    }
                </dl>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Cancel
                        </a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ProductID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash mr-1"></i> Delete Product
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Products
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.ProductID" class="btn btn-info">
                            <i class="fas fa-eye mr-1"></i> View Details
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
