@model Inventory_Management_System.ViewModels.SaleDetailsViewModel

@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
}

<!-- Breadcrumbs (Hidden when printing) -->
<nav aria-label="breadcrumb" class="no-print">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Sales</a></li>
        <li class="breadcrumb-item active text-slate-400" aria-current="page">@Model.InvoiceNumber</li>
    </ol>
</nav>

<!-- Page Action Header (Hidden when printing) -->
<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h1 class="h3 mb-1 text-white font-weight-bold">
            <i class="fas fa-file-invoice text-primary mr-2"></i>Sales Order Invoice
        </h1>
        <p class="small mb-0 text-slate-400">Official POS sales receipt and inventory deduction record</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left mr-1"></i> Back to Sales
        </a>
        <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="window.print();">
            <i class="fas fa-print mr-1"></i> Print Invoice
        </button>
        <a asp-action="Delete" asp-route-id="@Model.SaleID" class="btn btn-outline-danger" title="Delete Sale">
            <i class="fas fa-trash"></i>
        </a>
    </div>
</div>

<!-- Invoice Card (Print-ready) -->
<div class="card shadow-sm mb-4 invoice-card" style="background: #111827; border: 1px solid #1F2937;">
    <div class="card-body p-4 p-md-5">
        <!-- Invoice Header Row -->
        <div class="row align-items-start border-bottom pb-4 mb-4" style="border-color: #1F2937 !important;">
            <div class="col-sm-6">
                <div class="d-flex align-items-center mb-2">
                    <div class="invoice-logo mr-3">
                        <i class="fas fa-boxes text-primary fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="font-weight-bold text-white mb-0">@Model.StoreName</h4>
                        <span class="small text-slate-400">Inventory & Point of Sale System</span>
                    </div>
                </div>
                <p class="small mb-0 text-slate-400">
                    @Model.StoreAddress<br />
                    Phone: @Model.StorePhone &bull; Email: @Model.StoreEmail
                </p>
            </div>
            <div class="col-sm-6 text-sm-right mt-3 mt-sm-0">
                <h3 class="font-weight-bold text-primary mb-1">INVOICE</h3>
                <h5 class="text-white font-weight-bold mb-1"><code>@Model.InvoiceNumber</code></h5>
                <div class="small mb-2 text-slate-400">
                    <strong>Date:</strong> @Model.SaleDate.ToString("MMMM dd, yyyy")
                </div>
                <div>
                    <span class="badge badge-pill badge-success px-3 py-1 font-weight-bold text-uppercase shadow-sm">
                        <i class="fas fa-check-circle mr-1"></i> @Model.PaymentStatus
                    </span>
                </div>
            </div>
        </div>

        <!-- Customer & Order Information (Increased Spacing mb-5) -->
        <div class="row mb-5">
            <div class="col-md-6 mb-3 mb-md-0">
                <h6 class="text-uppercase font-weight-bold text-primary small mb-2">Billed To (Customer)</h6>
                <div class="p-3 rounded" style="background: #1a2234; border: 1px solid #1F2937;">
                    <h5 class="font-weight-bold text-white mb-1">
                        <i class="fas fa-user-circle text-primary mr-1"></i> @Model.CustomerInfo
                    </h5>
                    <p class="small mb-0 text-slate-400">Transaction Type: Retail POS Cash / Order</p>
                </div>
            </div>
            <div class="col-md-6">
                <h6 class="text-uppercase font-weight-bold text-primary small mb-2">Transaction Details</h6>
                <div class="p-3 rounded" style="background: #1a2234; border: 1px solid #1F2937;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-slate-400">Internal Order ID:</span>
                        <span class="font-weight-bold text-white">#@Model.SaleID</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-slate-400">Total Line Items:</span>
                        <span class="font-weight-bold text-white">@Model.Items.Count</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small text-slate-400">Total Quantity Sold:</span>
                        <span class="font-weight-bold text-white">@Model.TotalQuantity unit@(Model.TotalQuantity == 1 ? "" : "s")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0" style="background: #111827;">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 5%;" class="text-center py-2 px-3">#</th>
                        <th style="width: 45%;" class="py-2 px-3">PRODUCT DESCRIPTION</th>
                        <th style="width: 15%;" class="py-2 px-3">SKU</th>
                        <th style="width: 10%;" class="text-center py-2 px-3">QTY</th>
                        <th style="width: 12%;" class="text-right py-2 px-3">UNIT PRICE</th>
                        <th style="width: 13%;" class="text-right py-2 px-3">SUBTOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td class="text-center font-weight-bold text-slate-400 py-2 px-3 align-middle">@(i + 1)</td>
                            <td class="py-2 px-3 align-middle">
                                <div class="font-weight-bold text-white">
                                    @item.ProductName
                                </div>
                            </td>
                            <td class="py-2 px-3 align-middle">
                                <code style="background: #1e293b; color: #a5b4fc; border: 1px solid #334155; padding: 2px 6px; border-radius: 4px;">@item.SKU</code>
                            </td>
                            <td class="text-center font-weight-bold text-white py-2 px-3 align-middle">@item.Quantity</td>
                            <td class="text-right font-weight-bold text-white py-2 px-3 align-middle">$@item.UnitPrice.ToString("N2")</td>
                            <td class="text-right font-weight-bold text-success py-2 px-3 align-middle">$@item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals & Notes Section -->
        <div class="row align-items-end mt-4">
            <div class="col-md-7 mb-3 mb-md-0">
                <div class="p-3 rounded text-slate-400 small" style="background: #1a2234; border: 1px solid #1F2937;">
                    <h6 class="font-weight-bold text-white mb-1">Terms & Inventory Notes:</h6>
                    <ul class="pl-3 mb-0">
                        <li>All products have been atomically deducted from current warehouse inventory.</li>
                        <li>Prices reflected are permanent transaction snapshots as of order creation.</li>
                        <li>For inquiries or returns, please present this invoice within 14 days.</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-5">
                <div class="rounded p-3" style="background: #1a2234; border: 1px solid #1F2937;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-slate-400">Subtotal:</span>
                        <span class="font-weight-bold text-white">$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-slate-400">Tax (0.00%):</span>
                        <span class="font-weight-bold text-white">$0.00</span>
                    </div>
                    <hr class="my-2" style="border-color: #334155;" />
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="font-weight-bold text-white mb-0">Grand Total:</h5>
                        <h4 class="font-weight-bold text-success mb-0">$@Model.TotalAmount.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Sign-off (for printable receipts) -->
        <div class="mt-5 pt-4 border-top text-center text-slate-400 small" style="border-color: #1F2937 !important;">
            <p class="mb-1 font-weight-bold text-slate-300">Thank you for your business!</p>
            <p class="mb-0">Powered by IMS Enterprise Inventory Management System</p>
        </div>
    </div>
</div>

