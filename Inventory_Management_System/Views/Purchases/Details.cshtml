@model Inventory_Management_System.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<h1>Purchase Details</h1>

<div class="card mb-4">

    <div class="card-body">

        <h5 class="card-title">
            Purchase #@Model.PurchaseID
        </h5>

        <p>
            <strong>Supplier:</strong>
            @Model.Supplier?.SupplierName
        </p>

        <p>
            <strong>Purchase Date:</strong>
            @Model.PurchaseDate.ToShortDateString()
        </p>

        <p>
            <strong>Total Amount:</strong>
            @Model.TotalAmount.ToString("0.00")
        </p>

    </div>

</div>


<h3>Products</h3>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Cost</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.PurchaseItems)
        {
            <tr>

                <td>
                    @item.Product?.ProductName
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.UnitCost.ToString("0.00")
                </td>

                <td>
                    @((item.Quantity * item.UnitCost).ToString("0.00"))
                </td>

            </tr>
        }

    </tbody>

</table>


<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Purchases
    </a>

</div>