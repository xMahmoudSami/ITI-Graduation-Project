@model Inventory_Management_System.ViewModels.PurchaseDeleteViewModel

@{
    ViewData["Title"] = "Delete Purchase Order";
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm mb-4 border-left-@(Model.CanDelete ? "danger" : "warning")">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-@(Model.CanDelete ? "danger" : "warning")">
                    <i class="fas fa-@(Model.CanDelete ? "trash-alt" : "exclamation-triangle") mr-2"></i>
                    @(Model.CanDelete ? "Delete Purchase Order" : "Cannot Delete Purchase Order")
                </h6>
            </div>
            <div class="card-body">
                @if (!Model.CanDelete)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <strong>Deletion Blocked:</strong> @Model.BlockingReason
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mb-3" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Warning:</strong> Deleting this purchase order will automatically revert stock levels.
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-gray-600">Purchase ID</dt>
                    <dd class="col-sm-8"><code class="font-weight-bold">#@Model.PurchaseID</code></dd>

                    <dt class="col-sm-4 text-gray-600">Purchase Date</dt>
                    <dd class="col-sm-8 font-weight-bold text-gray-800">
                        <i class="fas fa-calendar-alt text-primary mr-1"></i>@Model.PurchaseDate.ToString("MMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-4 text-gray-600">Supplier</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.SupplierName) ? "N/A" : Model.SupplierName)</dd>

                    <dt class="col-sm-4 text-gray-600">Total Amount</dt>
                    <dd class="col-sm-8 font-weight-bold text-success">$@Model.TotalAmount.ToString("N2")</dd>

                    <dt class="col-sm-4 text-gray-600">Items Count</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-info px-2 py-1">@Model.ItemsCount item(s)</span>
                    </dd>
                </dl>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Cancel
                        </a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.PurchaseID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash mr-1"></i> Delete Purchase
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Purchases
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.PurchaseID" class="btn btn-info">
                            <i class="fas fa-eye mr-1"></i> View Details
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>