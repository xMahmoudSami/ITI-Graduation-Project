@model IEnumerable<Inventory_Management_System.ViewModels.PurchaseListItemViewModel>

@{
    ViewData["Title"] = Loc["Purchases"].Value;
}

<!-- Page Header -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">@Loc["PurchasesManagement"]</h1>
        <p class="text-muted small mb-0">@Loc["TrackManagePurchases"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm">
        <span class="icon text-white-50">
            <i class="fas fa-plus"></i>
        </span>
        <span class="text">@Loc["AddPurchase"]</span>
    </a>
</div>

<!-- Purchase List Table Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">@Loc["AllPurchasesList"] (@Model?.Count())</h6>
    </div>
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-shopping-cart fa-3x text-gray-300 mb-3"></i>
                <h5 class="text-gray-600 font-weight-bold">@Loc["NoPurchasesFound"]</h5>
                <p class="text-muted mb-3">@Loc["StartRecordingPurchase"]</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-1"></i> @Loc["AddNewPurchase"]
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 10%;">@Loc["ID"]</th>
                            <th>@Loc["Supplier"]</th>
                            <th>@Loc["PurchaseDate"]</th>
                            <th class="text-right">@Loc["TotalAmount"]</th>
                            <th class="text-right" style="width: 25%;">@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code>#@item.PurchaseID</code></td>
                                <td class="font-weight-bold text-gray-800">
                                    <i class="fas fa-truck text-primary mr-1"></i>
                                    @item.SupplierName
                                </td>
                                <td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-right font-weight-bold text-success">$@item.TotalAmount.ToString("N2")</td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.PurchaseID" class="btn btn-outline-info">
                                            <i class="fas fa-eye mr-1"></i> @Loc["Details"]
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.PurchaseID" class="btn btn-outline-primary">
                                            <i class="fas fa-edit mr-1"></i> @Loc["Edit"]
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PurchaseID" class="btn btn-outline-danger">
                                            <i class="fas fa-trash mr-1"></i> @Loc["Delete"]
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>