@model IEnumerable<Inventory_Management_System.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Purchases Management</h1>
    <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add New Purchase
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">All Purchases List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Supplier</th>
                        <th>Purchase Date</th>
                        <th>Total Amount</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var purchase in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">#@purchase.PurchaseID</td>
                            <td>@(purchase.Supplier?.SupplierName ?? "N/A")</td>
                            <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-success font-weight-bold">$@purchase.TotalAmount.ToString("N2")</td>
                            <td class="text-right">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@purchase.PurchaseID" class="btn btn-outline-info">
                                        <i class="fas fa-eye mr-1"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@purchase.PurchaseID" class="btn btn-outline-primary">
                                        <i class="fas fa-edit mr-1"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@purchase.PurchaseID" class="btn btn-outline-danger">
                                        <i class="fas fa-trash mr-1"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>