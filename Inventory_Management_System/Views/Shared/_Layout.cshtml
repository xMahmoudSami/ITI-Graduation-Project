@inject Inventory_Management_System.Models.ApplicationDbContext _context
@{
    var lowStockProducts = _context.Products
        .Where(p => p.StockQuantity <= p.LowStockThreshold)
        .OrderBy(p => p.StockQuantity)
        .Take(5)
        .Select(p => new { p.ProductID, p.ProductName, p.StockQuantity, p.LowStockThreshold, p.SKU })
        .ToList();

    var lowStockCount = _context.Products.Count(p => p.StockQuantity <= p.LowStockThreshold);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Inventory Management System</title>

    <!-- Custom fonts -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />

    <!-- Custom styles -->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/css/ai-chat.css" rel="stylesheet" />
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-controller="Dashboard" asp-action="Analytics">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-boxes"></i>
                </div>
                <div class="sidebar-brand-text mx-3">IMS Admin</div>
            </a>

            <hr class="sidebar-divider my-0" />

            <!-- Nav Item - Dashboard -->
            <li class="nav-item">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Analytics">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <hr class="sidebar-divider" />

            <div class="sidebar-heading">Management</div>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Products" asp-action="Index">
                    <i class="fas fa-fw fa-box"></i>
                    <span>Products</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Categories" asp-action="Index">
                    <i class="fas fa-fw fa-tags"></i>
                    <span>Categories</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Suppliers" asp-action="Index">
                    <i class="fas fa-fw fa-truck"></i>
                    <span>Suppliers</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Purchases" asp-action="Index">
                    <i class="fas fa-fw fa-shopping-bag"></i>
                    <span>Purchases</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Sales" asp-action="Index">
                    <i class="fas fa-fw fa-shopping-cart"></i>
                    <span>Sales</span>
                </a>
            </li>

            <hr class="sidebar-divider d-none d-md-block" />

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Search -->
                    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search position-relative">
                        <div class="input-group">
                            <input type="text" id="globalSearchInput" class="form-control bg-light border-0 small" placeholder="Search products, categories..." aria-label="Search" autocomplete="off">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button">
                                    <i class="fas fa-search fa-sm"></i>
                                </button>
                            </div>
                        </div>
                        <div id="searchResultsDropdown" class="dropdown-menu shadow animated--grow-in w-100 mt-1" style="display: none; position: absolute; top: 100%; left: 0; z-index: 1000;"></div>
                    </form>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <!-- Nav Item - Alerts -->
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell fa-fw"></i>
                                @if (lowStockCount > 0)
                                {
                                    <span class="badge badge-danger badge-counter">@lowStockCount</span>
                                }
                            </a>
                            <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="alertsDropdown">
                                <h6 class="dropdown-header bg-danger border-danger">
                                    Low Stock Alerts
                                </h6>
                                @if (lowStockProducts.Any())
                                {
                                    foreach (var item in lowStockProducts)
                                    {
                                        <a class="dropdown-item d-flex align-items-center" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID">
                                            <div class="mr-3">
                                                <div class="icon-circle bg-warning text-white">
                                                    <i class="fas fa-exclamation-triangle"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <div class="small text-gray-500">SKU: @item.SKU</div>
                                                <span class="font-weight-bold">@item.ProductName</span>
                                                <div class="small text-danger">Stock: @item.StockQuantity (Threshold: @item.LowStockThreshold)</div>
                                            </div>
                                        </a>
                                    }
                                    <a class="dropdown-item text-center small text-gray-500" asp-controller="Dashboard" asp-action="Analytics">Show All Alerts</a>
                                }
                                else
                                {
                                    <span class="dropdown-item text-center small text-gray-500">No low stock items</span>
                                }
                            </div>
                        </li>

                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- User Info -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">System Administrator</span>
                                <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg" />
                            </a>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->
                <!-- Begin Page Content -->
                <div class="container-fluid">
                    @RenderBody()
                </div>

            </div>
            <!-- End of Main Content -->
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Inventory Management System @DateTime.Now.Year</span>
                    </div>
                </div>
            </footer>

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- AI Chatbot -->
    <div id="ai-chatbot">

        <button id="ai-chat-button" type="button">
            <i class="fas fa-robot"></i>
        </button>

        <div id="ai-chat-window">

            <div id="ai-chat-header">
                <span>
                    <i class="fas fa-robot mr-2"></i>
                    AI Inventory Assistant
                </span>

                <button id="ai-chat-close" type="button">
                    &times;
                </button>
            </div>

            <div id="ai-chat-messages">
                <div class="ai-message">
                    Hello! I'm your inventory assistant. How can I help you?
                </div>
            </div>

            <div id="ai-chat-input-area">
                <input type="text"
                       id="ai-chat-input"
                       placeholder="Ask about your inventory..."
                       autocomplete="off" />

                <button id="ai-chat-send" type="button">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>

        </div>

    </div>
    <!-- Scripts -->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>

    <!-- Global Search Script (Matches GlobalSearch Controller Response Format) -->
    <script>
            $(document).ready(function () {
                let searchTimeout = null;

                $('#globalSearchInput').on('keyup input', function () {
                    let term = $(this).val().trim();
                    let dropdown = $('#searchResultsDropdown');

                    clearTimeout(searchTimeout);

                    if (term.length < 1) {
                        dropdown.hide().empty();
                        return;
                    }

                    searchTimeout = setTimeout(function () {
                        $.ajax({
                            url: '/Dashboard/GlobalSearch',
                            type: 'GET',
                            data: { term: term },
                            success: function (data) {
                                dropdown.empty();
                                let hasResults = false;

                                if (data.products && data.products.length > 0) {
                                    hasResults = true;
                                    dropdown.append('<h6 class="dropdown-header">Products</h6>');
                                    $.each(data.products, function (i, item) {
                                        dropdown.append(`
                                                    <a class="dropdown-item py-1" href="/Products/Details/${item.productID}">
                                                        <div class="font-weight-bold text-dark">${item.productName}</div>
                                                        <div class="small text-gray-500">SKU: ${item.sku}</div>
                                                    </a>
                                                `);
                                    });
                                }

                                if (data.categories && data.categories.length > 0) {
                                    hasResults = true;
                                    dropdown.append('<h6 class="dropdown-header">Categories</h6>');
                                    $.each(data.categories, function (i, item) {
                                        dropdown.append(`
                                                    <a class="dropdown-item py-1" href="/Categories/Details/${item.categoryID}">
                                                        <div class="font-weight-bold text-dark">${item.categoryName}</div>
                                                    </a>
                                                `);
                                    });
                                }

                                if (data.suppliers && data.suppliers.length > 0) {
                                    hasResults = true;
                                    dropdown.append('<h6 class="dropdown-header">Suppliers</h6>');
                                    $.each(data.suppliers, function (i, item) {
                                        dropdown.append(`
                                                    <a class="dropdown-item py-1" href="/Suppliers/Details/${item.supplierID}">
                                                        <div class="font-weight-bold text-dark">${item.supplierName}</div>
                                                    </a>
                                                `);
                                    });
                                }

                                if (hasResults) {
                                    dropdown.show();
                                } else {
                                    dropdown.append('<div class="dropdown-item small text-gray-500 p-2 text-center">No results found</div>');
                                    dropdown.show();
                                }
                            },
                            error: function () {
                                dropdown.hide().empty();
                            }
                        });
                    }, 300);
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.navbar-search').length) {
                        $('#searchResultsDropdown').hide();
                    }
                });
            });
    </script>
    <script>
            $(document).ready(function () {

                // Open / close chatbot
                $('#ai-chat-button').click(function () {
                    $('#ai-chat-window').toggle();
                });

                $('#ai-chat-close').click(function () {
                    $('#ai-chat-window').hide();
                });

                // Send message
                $('#ai-chat-send').click(function () {
                    sendAIMessage();
                });

                // Send with Enter
                $('#ai-chat-input').keypress(function (e) {
                    if (e.which === 13) {
                        sendAIMessage();
                    }
                });

                function sendAIMessage() {

                    const input = $('#ai-chat-input');
                    const message = input.val().trim();

                    if (!message) {
                        return;
                    }

                    // Show user message
                    $('#ai-chat-messages').append(`
                        <div class="user-message">
                            ${message}
                        </div>
                    `);

                    input.val('');

                    // Temporary loading message
                    const loadingMessage = $(`
                        <div class="ai-message" id="ai-loading">
                            Thinking...
                        </div>
                    `);

                    $('#ai-chat-messages').append(loadingMessage);

                    scrollChatToBottom();

                    // Call our C# API
                    $.ajax({
                        url: '/api/AI/chat',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            message: message
                        }),

                        success: function (data) {

                            $('#ai-loading').remove();

                            $('#ai-chat-messages').append(`
                                <div class="ai-message">
                                    ${data.response}
                                </div>
                            `);

                            scrollChatToBottom();
                        },

                        error: function (xhr) {

                            $('#ai-loading').remove();

                            $('#ai-chat-messages').append(`
                                <div class="ai-message">
                                    Sorry, something went wrong. Please try again.
                                </div>
                            `);

                            console.error(xhr);
                            scrollChatToBottom();
                        }
                    });
                }

                function scrollChatToBottom() {
                    const messages = $('#ai-chat-messages');

                    messages.scrollTop(messages[0].scrollHeight);
                }

            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>